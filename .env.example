# Copy this file to .env and fill in at least one key. Never share .env or commit it.

# Free keys, no card needed:
#   Gemini: https://aistudio.google.com/apikey
#   Groq:   https://console.groq.com/keys
GEMINI_API_KEY=
GROQ_API_KEY=

# What Jarvis calls you.
USER_NAME=

# Which brains to try, in order. Jarvis moves to the next one if a brain is
# rate-limited or offline. ollama only works once Ollama is installed.
JARVIS_PROVIDERS=gemini,groq,ollama

# Model per brain. Leave blank for the defaults. Type /models in Jarvis to list options.
GEMINI_MODEL=gemini-flash-lite-latest
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_URL=http://localhost:11434/v1

# How many back-and-forth exchanges Jarvis keeps in mind.
JARVIS_HISTORY_TURNS=12
